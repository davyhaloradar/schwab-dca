# Charles Schwab Developer Portal → App Key / App Secret
# Callback must match the portal exactly (see README "Callback URL").
# Local HTTPS, default APP_ROOT_PATH=/plan:
#   https://127.0.0.1:8765/plan/callback
# Production: set this to your public URL, for example
#   https://example.com/plan/callback
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8765/plan/callback

APP_HOST=127.0.0.1
APP_PORT=8765
APP_ROOT_PATH=/plan

# Public origin with no path. Notification links use this when DASHBOARD_URL
# is empty. Leave empty to take the origin from SCHWAB_CALLBACK_URL.
# Production example: https://example.com
APP_PUBLIC_BASE_URL=

# Optional dashboard link in notification emails.
# Default: APP_PUBLIC_BASE_URL (or the callback origin) + APP_ROOT_PATH + /
# Production example: https://example.com/plan/
DASHBOARD_URL=

# Comma-separated hostnames for CSRF Origin/Referer checks and same-site
# redirects. localhost and 127.0.0.1 are always allowed.
# Empty: callback host (plus APP_PUBLIC_BASE_URL / DASHBOARD_URL hosts) and
# the apex/www pair of each public name. Other subdomains are not implied.
# Suffix form: *.example.com
# Production example: example.com,www.example.com
ALLOWED_HOSTS=

# SAFETY: keep true until you intentionally go live
DRY_RUN=true

# Fund-safety hard caps (LIVE refuse if exceeded)
DCA_MAX_SHARES_PER_SYMBOL=5
DCA_MAX_NOTIONAL_USD=2000
# Seconds to reject a second successful LIVE submit for the same plan
DCA_LIVE_IDEMPOTENCY_SEC=60

# Order policy
# Empty = allow any valid ticker; e.g. VOO,QQQ
DCA_SYMBOL_ALLOWLIST=
# Cumulative LIVE notional across all plans per US/ET calendar day
DCA_MAX_DAILY_NOTIONAL_USD=5000

# Optional webhook: POST JSON on failures / cash / run complete (structured payload)
# 可选 Webhook：失败/现金/执行完成时 POST JSON（结构保持机器可读）
DCA_NOTIFY_WEBHOOK_URL=
# Webhook 总开关；false 或空 URL = 不发送 / master switch (empty URL also off)
DCA_NOTIFY_WEBHOOK_ENABLED=true

# Email via 163 SMTP（网易邮箱）。发送条件：TO + USER + PASSWORD 均已设置
# 也可在 Web UI「通知设置」(/plan/settings/notify) 配置；留空密码不覆盖已有授权码
# 邮件为 multipart（纯文本 + HTML），主题中文，如「【定投】QQQM 计划执行完成」
DCA_NOTIFY_EMAIL_ENABLED=true
# 收件人 / recipient (example: you@example.com)
DCA_NOTIFY_EMAIL_TO=
# 发件人，默认与 TO 或 SMTP_USER 相同 / From (default: TO or SMTP user)
DCA_NOTIFY_EMAIL_FROM=
DCA_NOTIFY_SMTP_HOST=smtp.163.com
# 端口：465=SSL；587=STARTTLS
DCA_NOTIFY_SMTP_PORT=465
DCA_NOTIFY_SMTP_USER=
# 163 授权码（非登录密码）/ authorization code (not login password)
DCA_NOTIFY_SMTP_PASSWORD=

# 通知策略（可配置，勿写死在代码）/ notification policy
# 手动运行（manual/run_now/ui）是否发邮件/Webhook；默认 true
DCA_NOTIFY_ON_MANUAL=true
# 自动调度是否通知；默认 true
DCA_NOTIFY_ON_SCHEDULED=true
# 预览确认是否通知；默认 false（避免刷屏）
DCA_NOTIFY_ON_PREVIEW=false
# 可选：仅这些 kind 发渠道通知（逗号分隔，空=全部）
# 例: run_complete,insufficient_cash,live_order_error,low_cash_warning
DCA_NOTIFY_KINDS=

# Durable due scanner interval (seconds)
DCA_DUE_TICK_SEC=120

# Cash monitoring (MARGIN accounts: never use buyingPower / margin BP)
# Warn when remaining DCA runs for a plan ≤ this (dashboard + optional notify)
DCA_CASH_WARN_RUNS=3
# Debounce low-cash notify (seconds; default 6h)
DCA_CASH_WARN_COOLDOWN_SEC=21600
# LIVE: skip if cash cannot be read from Accounts API (recommended true on margin)
DCA_REQUIRE_CASH_READ=true

# 5-minute VWAP 做T monitor (page /plan/t)
# Poll interval seconds (clamped 5–60). v1 never sends 做T orders.
T_TICK_SEC=5
T_DEFAULT_SYMBOLS=QQQM,AAPL
T_NOTIONAL_USD=2000
# Reserved. v1 ignores this and will not place Schwab orders for 做T.
T_LIVE_ORDERS=false
